CREATE TABLE library_items (
    id INT NOT NULL,
    mode TEXT NOT NULL,
    format TEXT NOT NULL,
    library_status TEXT NOT NULL,
    rating REAL NOT NULL,
    watched_episodes INT NOT NULL,
    total_episodes INT,
    added_at DATETIME NOT NULL,
    category_ids TEXT NOT NULL, -- comma-separated or JSON list
    PRIMARY KEY (id, mode)
);

CREATE TABLE library_categories (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    mode TEXT NOT NULL
);

CREATE TABLE media_caches (
    id INT NOT NULL,
    mode TEXT NOT NULL,
    title TEXT NOT NULL,
    cover_image TEXT NOT NULL,
    average_score INT,
    format TEXT,
    status TEXT,
    banner_image TEXT,
    extra_data TEXT, -- JSON blob for details
    PRIMARY KEY (id, mode)
);

CREATE TABLE notification_acks (
    media_key TEXT NOT NULL PRIMARY KEY, -- Format: 'mode_id' (e.g. 'anime_123')
    ack_value INT NOT NULL,
    start_value INT NOT NULL
);

-- Watch History Table (replaces watch_history_flat_records JSON blob)
CREATE TABLE watch_history (
    media_id TEXT NOT NULL,
    is_anime INT NOT NULL, -- 0 or 1
    is_manga INT NOT NULL, -- 0 or 1
    title TEXT NOT NULL,
    cover_image TEXT NOT NULL,
    format TEXT NOT NULL,
    average_score REAL NOT NULL DEFAULT 0.0,
    total_episodes INT NOT NULL DEFAULT 0,
    media_type_hint TEXT NOT NULL DEFAULT '',
    episodes TEXT NOT NULL, -- JSON list of watched numbers e.g. [1, 2, 3]
    timestamp INT NOT NULL, -- millisecondsSinceEpoch
    PRIMARY KEY (media_id, is_manga)
);
CREATE INDEX idx_watch_history_timestamp ON watch_history(timestamp DESC);

-- Continue Watching Metadata Table (replaces <prefix>continue_watching_metadata_* keys)
CREATE TABLE continue_watching (
    media_id TEXT NOT NULL PRIMARY KEY,
    prefix TEXT NOT NULL, -- 'anime_' or 'movie_'
    metadata_json TEXT NOT NULL,
    last_episode INT NOT NULL,
    timestamp INT NOT NULL
);
CREATE INDEX idx_continue_watching_timestamp ON continue_watching(timestamp DESC);

-- Playback Positions Table (replaces <prefix>playback_pos_* and <prefix>playback_dur_*)
CREATE TABLE playback_positions (
    media_id TEXT NOT NULL,
    episode INT NOT NULL,
    prefix TEXT NOT NULL, -- 'anime_' or 'movie_'
    position_ms INT NOT NULL,
    duration_ms INT NOT NULL,
    saved_at INT NOT NULL,
    PRIMARY KEY (media_id, episode)
);

-- FTS5 virtual table for searching titles
CREATE VIRTUAL TABLE library_fts USING fts5(
    media_id,
    media_mode,
    title,
    synonyms
);

-- Triggers to auto-sync library_fts with media_caches
CREATE TRIGGER media_caches_insert_fts AFTER INSERT ON media_caches BEGIN
    INSERT INTO library_fts(media_id, media_mode, title, synonyms) 
    VALUES (new.id, new.mode, new.title, new.extra_data);
END;

CREATE TRIGGER media_caches_delete_fts AFTER DELETE ON media_caches BEGIN
    DELETE FROM library_fts WHERE media_id = old.id AND media_mode = old.mode;
END;

CREATE TRIGGER media_caches_update_fts AFTER UPDATE ON media_caches BEGIN
    DELETE FROM library_fts WHERE media_id = old.id AND media_mode = old.mode;
    INSERT INTO library_fts(media_id, media_mode, title, synonyms) 
    VALUES (new.id, new.mode, new.title, new.extra_data);
END;
